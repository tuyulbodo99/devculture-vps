set -euo pipefail

# ── Colors ─────────────────────────────────────────────────────
R='\033[0m'
BOLD='\033[1m'; DIM='\033[2m'
RED='\033[1;31m'; GRN='\033[1;32m'; YLW='\033[1;33m'
CYN='\033[1;36m'; WHT='\033[1;37m'; MGT='\033[1;35m'
BLU='\033[1;34m'

# ── Box drawing ────────────────────────────────────────────────
LINE='╔══════════════════════════════════════════════════════════╗'
LSEP='╠══════════════════════════════════════════════════════════╣'
LDIV='╟──────────────────────────────────────────────────────────╢'
LBOT='╚══════════════════════════════════════════════════════════╝'

box() {
  local txt="$1" w=58
  local plain; plain=$(printf '%b' "$txt" | sed 's/\x1b\[[0-9;]*m//g')
  local pad=$(( w - ${#plain} )); [[ $pad -lt 0 ]] && pad=0
  printf "║ %b%${pad}s ║\n" "$txt" ""
}
div()  { echo -e "${BLU}${LDIV}${R}"; }
sep()  { echo -e "${BLU}${LSEP}${R}"; }
top()  { echo -e "${BLU}${LINE}${R}"; }
bot()  { echo -e "${BLU}${LBOT}${R}"; }

# ── Service status helper ──────────────────────────────────────
svc_status() {
  local name="$1"
  if systemctl is-active --quiet "$name" 2>/dev/null; then
    printf "${GRN}● RUNNING${R}"
  elif systemctl list-units --full -all 2>/dev/null | grep -q "$name"; then
    printf "${RED}● STOPPED${R}"
  else
    printf "${DIM}○ NOT INSTALLED${R}"
  fi
}

# ── System info ────────────────────────────────────────────────
get_sysinfo() {
  SYS_IP=$(curl -fsSL ipv4.icanhazip.com 2>/dev/null || hostname -I | awk '{print $1}')
  SYS_OS=$(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d'"' -f2 || echo "Unknown OS")
  SYS_RAM=$(free -h | awk 'NR==2 {printf "%s / %s", $3, $2}')
  SYS_DISK=$(df -h / | awk 'NR==2 {printf "%s / %s (%s)", $3, $2, $5}')
  SYS_UPTIME=$(uptime -p 2>/dev/null | sed 's/up //' || echo "N/A")
  SYS_LOAD=$(uptime | awk -F'load average:' '{print $2}' | xargs)
  SYS_CPU=$(nproc 2>/dev/null || grep -c ^processor /proc/cpuinfo)
}

