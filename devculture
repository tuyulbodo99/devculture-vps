# ── Main Menu ──────────────────────────────────────────────────
main_menu() {
  while true; do
    show_banner
    show_sysinfo
    show_services
    top
    box "${BOLD}${YLW}  ◈  DEVCULTURE VPS — MAIN MENU${R}"
    sep
    box "  ${GRN}[1]${R}  SSH User Management"
    box "  ${GRN}[2]${R}  Xray / VPN Management"
    box "  ${GRN}[3]${R}  Service Control"
    box "  ${GRN}[4]${R}  Bandwidth & Limit"
    box "  ${GRN}[5]${R}  Backup & Restore"
    box "  ${GRN}[6]${R}  Settings & Update"
    div
    box "  ${CYN}[s]${R}  Cek Status Cepat"
    box "  ${CYN}[r]${R}  Restart Semua Service"
    box "  ${CYN}[u]${R}  Update Script"
    div
    box "  ${RED}[0]${R}  Keluar"
    bot
    echo -ne "\n  ${CYN}Pilihan${R} » "; read -r choice

    case "$choice" in
      1) menu_ssh ;;
      2) menu_xray ;;
      3) menu_services ;;
      4) menu_bandwidth ;;
      5) menu_backup ;;
      6) menu_settings ;;
      s|S) cmd_status; read -rp "  Tekan Enter untuk lanjut..." ;;
      r|R) cmd_restart; sleep 2 ;;
      u|U) cmd_update ;;
      0|q|Q|exit) echo -e "\n  ${DIM}Sampai jumpa! — @devculturebot${R}\n"; exit 0 ;;
      *) echo -e "\n  ${RED}Pilihan tidak valid.${R}"; sleep 1 ;;
    esac
  done
}

# ── Entry point ────────────────────────────────────────────────
case "${1:-}" in
  status)  cmd_status ;;
  restart) cmd_restart ;;
  update)  cmd_update ;;
  ssl)     cmd_ssl ;;
  log)     cmd_log ;;
  help|-h|--help) cmd_help ;;
  "") main_menu ;;
  *) echo -e "\n  ${RED}Unknown command: $1${R}\n  Run '${CYN}devculture help${R}' for usage.\n"; exit 1 ;;
esac
