RESET="\033[0m"; BOLD="\033[1m"; DIM="\033[2m"
BBLUE="\033[1;34m"; BCYAN="\033[1;36m"; BGREEN="\033[1;32m"
BYELLOW="\033[1;33m"; RED="\033[0;31m"; WHITE="\033[1;37m"

DC_VERSION="3.2.0"
DC_AUTHOR="@devculturebot"
DC_REPO="github.com/tuyulbodo99/devculture-vps"
DC_LOGFILE="/var/log/devculture-install.log"
SERVICES=("nginx" "xray" "v2ray" "dropbear" "fail2ban" "openvpn@server")

# ─── Helpers ────────────────────────────────────────────────────

banner() {
  clear
  echo -e "${BBLUE}"
  echo "  ██████╗ ███████╗██╗   ██╗ ██████╗██╗   ██╗██╗  ████████╗██╗   ██╗██████╗ ███████╗"
  echo "  ██╔══██╗██╔════╝██║   ██║██╔════╝██║   ██║██║  ╚══██╔══╝██║   ██║██╔══██╗██╔════╝"
  echo "  ██║  ██║█████╗  ██║   ██║██║     ██║   ██║██║     ██║   ██║   ██║██████╔╝█████╗  "
  echo "  ██║  ██║██╔══╝  ╚██╗ ██╔╝██║     ██║   ██║██║     ██║   ██║   ██║██╔══██╗██╔══╝  "
  echo "  ██████╔╝███████╗ ╚████╔╝ ╚██████╗╚██████╔╝███████╗██║   ╚██████╔╝██║  ██║███████╗"
  echo "  ╚═════╝ ╚══════╝  ╚═══╝   ╚═════╝ ╚═════╝ ╚══════╝╚═╝    ╚═════╝ ╚═╝  ╚═╝╚══════╝"
  echo -e "${RESET}"
  echo -e "  ${DIM}VPS Auto Installer & Management Panel ${WHITE}v${DC_VERSION}${RESET}  ${DIM}│  ${DC_AUTHOR}${RESET}"
  echo -e "  ${DIM}${DC_REPO}${RESET}"
  echo ""
}

small_banner() {
  clear
  echo -e "  ${BBLUE}╔══════════════════════════════════════════════════════════╗${RESET}"
  echo -e "  ${BBLUE}║${RESET}  ${BCYAN}DevCulture VPS${RESET}  ${DIM}v${DC_VERSION}  │  ${DC_AUTHOR}${RESET}               ${BBLUE}║${RESET}"
  echo -e "  ${BBLUE}╚══════════════════════════════════════════════════════════╝${RESET}"
  echo ""
}

spinner() {
  local pid=$1 msg="${2:-Working...}"
  local sp='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  local i=0
  while kill -0 "$pid" 2>/dev/null; do
    printf "\r  ${BCYAN}${sp:$i:1}${RESET}  ${DIM}${msg}${RESET}"
    i=$(( (i+1) % ${#sp} ))
    sleep 0.1
  done
  printf "\r  ${BGREEN}✔${RESET}  ${msg}  \n"
}

svc_status() {
  local SVC="$1"
  if systemctl is-active --quiet "$SVC" 2>/dev/null; then
    echo -e "${BGREEN}● AKTIF${RESET}"
  elif systemctl list-units --full -all 2>/dev/null | grep -q "^${SVC}.service"; then
    echo -e "${RED}○ MATI${RESET}"
  else
    echo -e "${DIM}— N/A${RESET}"
  fi
}

get_info() {
  SERVER_IP=$(curl -fsSL --max-time 5 ipv4.icanhazip.com 2>/dev/null || hostname -I | awk '{print $1}')
  SERVER_OS=$(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '"')
  SERVER_UP=$(uptime -p 2>/dev/null)
  SERVER_MEM=$(free -m 2>/dev/null | awk '/Mem:/{printf "%.0f/%.0f MB (%.0f%%)", $3,$2,$3/$2*100}')
  SERVER_DISK=$(df -h / 2>/dev/null | awk 'NR==2{printf "%s/%s (%s used)", $3,$2,$5}')
  SERVER_DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "N/A")
  SERVER_LOAD=$(uptime 2>/dev/null | awk -F'load average: ' '{print $2}')
}

notify_tg() {
  [ -x /usr/local/bin/dc-notify ] && /usr/local/bin/dc-notify "$1" "${2:-info}" 2>/dev/null || true
}

# ─── Views ──────────────────────────────────────────────────────

view_status() {
  small_banner
  get_info
  echo -e "  ${BYELLOW}[ System Info ]${RESET}"
  echo -e "  🌐 IP       : ${BCYAN}${SERVER_IP}${RESET}"
  echo -e "  🌍 Domain   : ${BCYAN}${SERVER_DOMAIN}${RESET}"
  echo -e "  💻 OS       : ${DIM}${SERVER_OS}${RESET}"
  echo -e "  ⏱  Uptime   : ${DIM}${SERVER_UP}${RESET}"
  echo -e "  🔥 Load     : ${DIM}${SERVER_LOAD}${RESET}"
  echo -e "  💾 RAM      : ${DIM}${SERVER_MEM}${RESET}"
  echo -e "  💿 Disk     : ${DIM}${SERVER_DISK}${RESET}"
  echo ""
  echo -e "  ${BYELLOW}[ Services ]${RESET}"
  for SVC in "${SERVICES[@]}"; do
    printf "  %-22s %s\n" "${SVC}" "$(svc_status "$SVC")"
  done
  echo ""
  read -rp "  Tekan ENTER untuk kembali... "
}

view_restart() {
  small_banner
  echo -e "  ${BYELLOW}⟳ Me-restart semua service...${RESET}"
  echo ""
  for SVC in "${SERVICES[@]}"; do
    if systemctl list-units --full -all 2>/dev/null | grep -q "^${SVC}.service"; then
      systemctl restart "$SVC" 2>/dev/null && \
        echo -e "  ${BGREEN}✔${RESET}  ${SVC}" || \
        echo -e "  ${RED}✘${RESET}  ${SVC}"
    fi
  done
  echo ""
  notify_tg "🔄 Semua service di-restart via <code>devculture restart</code>" "info"
  read -rp "  Tekan ENTER untuk kembali... "
}

view_ssl() {
  small_banner
  echo -e "  ${BYELLOW}⟳ Renew SSL Certificate...${RESET}"
  if [ -f /usr/local/bin/ssl-renew.sh ]; then
    bash /usr/local/bin/ssl-renew.sh renew 2>&1 | tail -20
  else
    certbot renew --force-renewal 2>&1 | tail -20 || \
      echo -e "  ${RED}✘ Certbot tidak terinstall atau gagal.${RESET}"
  fi
  notify_tg "🔑 SSL Certificate di-renew via devculture ssl" "ok"
  echo ""
  read -rp "  Tekan ENTER untuk kembali... "
}

view_update() {
  small_banner
  echo -e "  ${BYELLOW}⟳ Mengupdate DevCulture scripts...${RESET}"
  echo ""
  BASE="https://raw.githubusercontent.com/tuyulbodo99/devculture-vps/main"
  {
    curl -fsSL "$BASE/devculture" -o /usr/local/bin/devculture 2>/dev/null && \
      chmod +x /usr/local/bin/devculture && \
      echo -e "  ${BGREEN}✔${RESET}  devculture command"
    curl -fsSL "$BASE/bot/bot.js" -o /usr/local/bin/devculture-bot.js 2>/dev/null && \
      echo -e "  ${BGREEN}✔${RESET}  devculture-bot.js"
    curl -fsSL "$BASE/bot/notify.sh" -o /usr/local/bin/dc-notify 2>/dev/null && \
      chmod +x /usr/local/bin/dc-notify && \
      echo -e "  ${BGREEN}✔${RESET}  dc-notify"
    curl -fsSL "$BASE/bot/monitor.sh" -o /usr/local/bin/dc-monitor 2>/dev/null && \
      chmod +x /usr/local/bin/dc-monitor && \
      echo -e "  ${BGREEN}✔${RESET}  dc-monitor"
  }
  notify_tg "🔄 DevCulture scripts diupdate ke versi terbaru via devculture update" "ok"
  echo ""
  echo -e "  ${BGREEN}✔ Update selesai! Restart devculture untuk melihat perubahan.${RESET}"
  read -rp "  Tekan ENTER untuk kembali... "
}

view_log() {
  small_banner
  echo -e "  ${BYELLOW}[ Log Instalasi — 50 baris terakhir ]${RESET}"
  echo ""
  if [ -f "$DC_LOGFILE" ]; then
    tail -50 "$DC_LOGFILE"
  else
    echo -e "  ${DIM}Log belum ada.${RESET}"
  fi
  echo ""
  read -rp "  Tekan ENTER untuk kembali... "
}

# ─── Submenu: SSH Management ─────────────────────────────────────

menu_ssh() {
  while true; do
    small_banner
    echo -e "  ${BYELLOW}[ SSH User Management ]${RESET}"
    echo ""
    echo -e "  [${BCYAN}1${RESET}]  Buat Akun SSH"
    echo -e "  [${BCYAN}2${RESET}]  Hapus Akun SSH"
    echo -e "  [${BCYAN}3${RESET}]  Cek Akun SSH"
    echo -e "  [${BCYAN}4${RESET}]  List Semua User"
    echo -e "  [${BCYAN}5${RESET}]  Cek Login Aktif"
    echo -e "  [${BCYAN}6${RESET}]  Perpanjang Akun"
    echo -e "  [${BCYAN}0${RESET}]  Kembali"
    echo ""
    read -rp "  Pilih [0-6]: " OPT
    case "$OPT" in
      1) bash /etc/devculture/menu/addssh 2>/dev/null || bash /root/menu/addssh 2>/dev/null || echo "Script tidak ditemukan." ;;
      2) bash /etc/devculture/menu/delssh 2>/dev/null || bash /root/menu/delssh 2>/dev/null || echo "Script tidak ditemukan." ;;
      3) bash /etc/devculture/menu/cekssh 2>/dev/null || bash /root/menu/cekssh 2>/dev/null || echo "Script tidak ditemukan." ;;
      4)
        small_banner
        echo -e "  ${BYELLOW}[ List User SSH Aktif ]${RESET}"
        echo ""
        DB="/etc/devculture/users.json"
        if [ -f "$DB" ]; then
          node -e "
            const db=JSON.parse(require('fs').readFileSync('$DB','utf8'));
            if(!db.users.length){console.log('  Belum ada user.');process.exit();}
            db.users.forEach((u,i)=>{
              const exp=new Date(u.exp+'T00:00:00Z');
              const daysLeft=Math.ceil((exp-Date.now())/86400000);
              const status=daysLeft>0?'aktif':'expired';
              console.log('  '+(i+1)+'. '+u.user.padEnd(20)+' │ exp: '+u.exp+' │ quota: '+(u.quota||'∞')+'GB │ '+status);
            });
          " 2>/dev/null || grep "^#ssh#" /etc/ssh/.ssh.db 2>/dev/null | awk '{printf "  %s │ exp: %s │ quota: %sGB\n", $2, $5, $4}'
        else
          grep "^#ssh#" /etc/ssh/.ssh.db 2>/dev/null | awk '{printf "  %s │ exp: %s │ quota: %sGB\n", $2, $5, $4}' || echo "  Belum ada user."
        fi
        echo ""
        read -rp "  Tekan ENTER... "
        ;;
      5)
        small_banner
        echo -e "  ${BYELLOW}[ User Login Aktif ]${RESET}"
        echo ""
        who 2>/dev/null || w 2>/dev/null || echo "  Tidak ada login aktif."
        echo ""
        read -rp "  Tekan ENTER... "
        ;;
      6) bash /etc/devculture/menu/renewssh 2>/dev/null || echo "Script tidak ditemukan."; sleep 2 ;;
      0|"") break ;;
    esac
  done
}

# ─── Submenu: Xray / VPN ──────────────────────────────────────────

menu_xray() {
  while true; do
    small_banner
    echo -e "  ${BYELLOW}[ Xray / VPN Management ]${RESET}"
    echo ""
    echo -e "  [${BCYAN}1${RESET}]  Buat Akun Xray VMess"
    echo -e "  [${BCYAN}2${RESET}]  Buat Akun Xray VLess"
    echo -e "  [${BCYAN}3${RESET}]  Buat Akun Trojan"
    echo -e "  [${BCYAN}4${RESET}]  Hapus Akun Xray"
    echo -e "  [${BCYAN}5${RESET}]  Cek Akun Xray"
    echo -e "  [${BCYAN}6${RESET}]  Restart Xray"
    echo -e "  [${BCYAN}7${RESET}]  Lihat Config Xray"
    echo -e "  [${BCYAN}0${RESET}]  Kembali"
    echo ""
    read -rp "  Pilih [0-7]: " OPT
    case "$OPT" in
      1) bash /etc/devculture/menu/addvmess 2>/dev/null || bash /root/menu/addvmess 2>/dev/null || echo "Script tidak ditemukan." ;;
      2) bash /etc/devculture/menu/addvless 2>/dev/null || bash /root/menu/addvless 2>/dev/null || echo "Script tidak ditemukan." ;;
      3) bash /etc/devculture/menu/addtrojan 2>/dev/null || bash /root/menu/addtrojan 2>/dev/null || echo "Script tidak ditemukan." ;;
      4) bash /etc/devculture/menu/delxray 2>/dev/null || bash /root/menu/delxray 2>/dev/null || echo "Script tidak ditemukan." ;;
      5) bash /etc/devculture/menu/cekxray 2>/dev/null || bash /root/menu/cekxray 2>/dev/null || echo "Script tidak ditemukan." ;;
      6) systemctl restart xray 2>/dev/null && echo -e "  ${BGREEN}✔ Xray restarted${RESET}" || echo -e "  ${RED}✘ Gagal${RESET}"; sleep 2 ;;
      7) cat /etc/xray/config.json 2>/dev/null | head -60 || echo "Config tidak ditemukan."; read -rp "  ENTER... " ;;
      0|"") break ;;
    esac
  done
}

# ─── Submenu: Telegram Bot ─────────────────────────────────────────

menu_bot() {
  BOT_SCRIPT="/etc/devculture/bot/install-bot.sh"
  if [ ! -f "$BOT_SCRIPT" ]; then
    small_banner
    echo -e "  ${BYELLOW}⟳ Mengunduh Bot Manager...${RESET}"
    mkdir -p /etc/devculture/bot
    curl -fsSL "https://raw.githubusercontent.com/tuyulbodo99/devculture-vps/main/bot/install-bot.sh" \
      -o "$BOT_SCRIPT" 2>/dev/null || \
    wget -qO "$BOT_SCRIPT" "https://raw.githubusercontent.com/tuyulbodo99/devculture-vps/main/bot/install-bot.sh" 2>/dev/null
    chmod +x "$BOT_SCRIPT"
  fi
  bash "$BOT_SCRIPT"
}

# ─── Submenu: System & Backup ────────────────────────────────────

menu_system() {
  while true; do
    small_banner
    echo -e "  ${BYELLOW}[ System & Maintenance ]${RESET}"
    echo ""
    echo -e "  [${BCYAN}1${RESET}]  System Info Lengkap"
    echo -e "  [${BCYAN}2${RESET}]  Restart Semua Service"
    echo -e "  [${BCYAN}3${RESET}]  Renew SSL Certificate"
    echo -e "  [${BCYAN}4${RESET}]  Update Script DevCulture"
    echo -e "  [${BCYAN}5${RESET}]  Bersihkan Log Lama"
    echo -e "  [${BCYAN}6${RESET}]  Cek Koneksi Internet"
    echo -e "  [${BCYAN}7${RESET}]  Bandwidth Monitor"
    echo -e "  [${BCYAN}8${RESET}]  Lihat Log Instalasi"
    echo -e "  [${BCYAN}0${RESET}]  Kembali"
    echo ""
    read -rp "  Pilih [0-8]: " OPT
    case "$OPT" in
      1) view_status; return ;;
      2) view_restart; return ;;
      3) view_ssl ;;
      4) view_update ;;
      5)
        small_banner
        echo -e "  ${BYELLOW}⟳ Membersihkan log lama...${RESET}"
        journalctl --vacuum-time=7d 2>/dev/null && echo -e "  ${BGREEN}✔ Journal logs (>7d) dibersihkan${RESET}"
        find /var/log -name "*.log" -mtime +14 -delete 2>/dev/null && echo -e "  ${BGREEN}✔ Log files (>14d) dibersihkan${RESET}"
        read -rp "  ENTER... "
        ;;
      6)
        small_banner
        echo -e "  ${BYELLOW}[ Cek Koneksi ]${RESET}"
        echo ""
        echo -ne "  icanhazip.com  : "
        curl -fsSL --max-time 5 ipv4.icanhazip.com 2>/dev/null && echo "" || echo -e "${RED}GAGAL${RESET}"
        echo -ne "  google.com     : "
        curl -s --max-time 5 -o /dev/null -w "%{http_code}" https://google.com 2>/dev/null || echo -e "${RED}GAGAL${RESET}"
        echo ""
        read -rp "  ENTER... "
        ;;
      7)
        small_banner
        echo -e "  ${BYELLOW}[ Bandwidth Monitor ]${RESET}"
        vnstat 2>/dev/null || ifstat -i eth0 1 5 2>/dev/null || echo "  Tidak tersedia (install: apt install vnstat)"
        read -rp "  ENTER... "
        ;;
      8) view_log ;;
      0|"") break ;;
    esac
  done
}

# ─── Non-interactive commands ────────────────────────────────────

case "${1:-}" in
  status)
    get_info
    echo "=== DevCulture VPS Status v${DC_VERSION} ==="
    echo "IP      : ${SERVER_IP}"
    echo "Domain  : ${SERVER_DOMAIN}"
    echo "OS      : ${SERVER_OS}"
    echo "Uptime  : ${SERVER_UP}"
    echo "RAM     : ${SERVER_MEM}"
    echo "Disk    : ${SERVER_DISK}"
    echo "Load    : ${SERVER_LOAD}"
    echo ""
    echo "=== Services ==="
    for SVC in "${SERVICES[@]}"; do
      if systemctl list-units --full -all 2>/dev/null | grep -q "^${SVC}.service"; then
        STATUS=$(systemctl is-active "$SVC" 2>/dev/null || echo "unknown")
        printf "%-22s %s\n" "$SVC" "$STATUS"
      fi
    done
    exit 0
    ;;
  restart)
    echo "Restarting services..."
    for SVC in "${SERVICES[@]}"; do
      systemctl restart "$SVC" 2>/dev/null && echo "  ✔ $SVC" || true
    done
    notify_tg "🔄 Services restarted via devculture restart" "info"
    exit 0
    ;;
  update) view_update; exit 0 ;;
  ssl)    view_ssl;    exit 0 ;;
  log)    view_log;    exit 0 ;;
  help|--help|-h)
    echo "DevCulture VPS Panel v${DC_VERSION}"
    echo ""
    echo "Usage: devculture [command]"
    echo ""
    echo "Commands:"
    echo "  (kosong)   Buka menu interaktif"
    echo "  status     Tampilkan status sistem & services"
    echo "  restart    Restart semua service"
    echo "  update     Update script ke versi terbaru"
    echo "  ssl        Renew SSL certificate"
    echo "  log        Lihat log instalasi"
    echo "  help       Tampilkan bantuan ini"
    echo ""
    echo "  ${DC_AUTHOR} | ${DC_REPO}"
    exit 0
    ;;
esac

# ─── Interactive Main Menu ───────────────────────────────────────

while true; do
  banner
  get_info
  echo -e "  ${DIM}🌐 ${SERVER_IP}  │  ⏱ ${SERVER_UP}  │  💾 ${SERVER_MEM}${RESET}"
  echo ""
  echo -e "  ${BYELLOW}┌─── Main Menu ───────────────────────────────────────┐${RESET}"
  echo -e "  ${BYELLOW}│${RESET}  [${BCYAN}1${RESET}]  SSH & OpenVPN Management          [${BCYAN}4${RESET}]  Update    ${BYELLOW}│${RESET}"
  echo -e "  ${BYELLOW}│${RESET}  [${BCYAN}2${RESET}]  Xray / V2Ray / Trojan             [${BCYAN}5${RESET}]  SSL Renew ${BYELLOW}│${RESET}"
  echo -e "  ${BYELLOW}│${RESET}  [${BCYAN}3${RESET}]  Telegram Bot & Notifikasi         [${BCYAN}6${RESET}]  Log       ${BYELLOW}│${RESET}"
  echo -e "  ${BYELLOW}│${RESET}  [${BCYAN}s${RESET}]  Status Sistem                     [${BCYAN}r${RESET}]  Restart   ${BYELLOW}│${RESET}"
  echo -e "  ${BYELLOW}│${RESET}  [${BCYAN}m${RESET}]  System & Maintenance              [${BCYAN}0${RESET}]  Keluar    ${BYELLOW}│${RESET}"
  echo -e "  ${BYELLOW}└─────────────────────────────────────────────────────┘${RESET}"
  echo ""
  read -rp "  Pilih menu: " OPT
  case "$OPT" in
    1) menu_ssh ;;
    2) menu_xray ;;
    3) menu_bot ;;
    4) view_update ;;
    5) view_ssl ;;
    6) view_log ;;
    s|S) view_status ;;
    r|R) view_restart ;;
    m|M) menu_system ;;
    0|q|Q|"")
      clear
      echo -e "  ${DIM}DevCulture VPS Panel — ${DC_AUTHOR}${RESET}"
      echo ""
      break
      ;;
  esac
done
