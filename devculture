# ── Quick commands (non-interactive) ──────────────────────────
cmd_status() {
  show_banner
  show_sysinfo
  show_services
}

cmd_restart() {
  echo -e "\n${CYN}Restarting services...${R}"
  for svc in nginx xray v2ray ws-stunnel dropbear fail2ban; do
    systemctl restart "$svc" 2>/dev/null \
      && echo -e "  ${GRN}✔${R}  $svc" \
      || echo -e "  ${DIM}○${R}  $svc (not running)"
  done
  echo -e "\n${GRN}Done.${R}"
}

cmd_update() {
  bash <(curl -fsSL https://raw.githubusercontent.com/tuyulbodo99/devculture-vps/main/update/update.sh)
}

cmd_ssl() {
  bash <(curl -fsSL https://raw.githubusercontent.com/tuyulbodo99/devculture-vps/main/ssl/ssl-renew.sh)
}

cmd_log() {
  tail -n 50 /var/log/devculture-install.log 2>/dev/null || echo "No log found."
}

