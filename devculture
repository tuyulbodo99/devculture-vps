# ── Service Control ────────────────────────────────────────────
menu_services() {
  while true; do
    show_banner
    show_services
    top
    box "${BOLD}${YLW}  ◈  SERVICE CONTROL${R}"
    sep
    box "  ${GRN}[1]${R}  Restart Semua Service"
    box "  ${GRN}[2]${R}  Restart Nginx"
    box "  ${GRN}[3]${R}  Restart Xray"
    box "  ${GRN}[4]${R}  Restart V2Ray"
    box "  ${GRN}[5]${R}  Restart WebSocket"
    box "  ${GRN}[6]${R}  Restart OpenVPN"
    div
    box "  ${GRN}[7]${R}  Stop Semua Service"
    box "  ${GRN}[8]${R}  Start Semua Service"
    div
    box "  ${RED}[0]${R}  Kembali"
    bot
    echo -ne "\n  ${CYN}Pilihan${R} » "; read -r opt
    case $opt in
      1)
        echo -ne "\n  ${CYN}Restarting all services...${R} "
        for svc in nginx xray v2ray ws-stunnel dropbear fail2ban; do
          systemctl restart "$svc" 2>/dev/null && printf "${GRN}${svc}✔${R} " || printf "${RED}${svc}✘${R} "
        done
        echo -e "\n  ${GRN}Done.${R}"; sleep 2 ;;
      2) systemctl restart nginx   && echo -e "\n  ${GRN}Nginx restarted.${R}"   || echo -e "\n  ${RED}Failed.${R}"; sleep 1 ;;
      3) systemctl restart xray    && echo -e "\n  ${GRN}Xray restarted.${R}"    || echo -e "\n  ${RED}Failed.${R}"; sleep 1 ;;
      4) systemctl restart v2ray   && echo -e "\n  ${GRN}V2Ray restarted.${R}"   || echo -e "\n  ${RED}Failed.${R}"; sleep 1 ;;
      5) systemctl restart ws-stunnel && echo -e "\n  ${GRN}WebSocket restarted.${R}" || echo -e "\n  ${RED}Failed.${R}"; sleep 1 ;;
      6) systemctl restart openvpn@server && echo -e "\n  ${GRN}OpenVPN restarted.${R}" || echo -e "\n  ${RED}Failed.${R}"; sleep 1 ;;
      7)
        for svc in nginx xray v2ray ws-stunnel dropbear; do systemctl stop "$svc" 2>/dev/null || true; done
        echo -e "\n  ${YLW}All services stopped.${R}"; sleep 2 ;;
      8)
        for svc in nginx xray v2ray ws-stunnel dropbear fail2ban; do systemctl start "$svc" 2>/dev/null || true; done
        echo -e "\n  ${GRN}All services started.${R}"; sleep 2 ;;
      0) break ;;
      *) echo -e "\n  ${RED}Pilihan tidak valid.${R}"; sleep 1 ;;
    esac
  done
}

