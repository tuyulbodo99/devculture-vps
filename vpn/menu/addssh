#!/bin/bash
# =================================================================
#   DevCulture VPS — Create SSH/OpenVPN Account  v3.2.0
#   @devculturebot | github.com/tuyulbodo99/devculture-vps
# =================================================================
source /usr/local/lib/devculture/utils.sh 2>/dev/null || true

# --- Fallback colors ---
RESET="\033[0m"; BBLUE="\033[1;34m"; BCYAN="\033[1;36m"
BGREEN="\033[1;32m"; BYELLOW="\033[1;33m"; RED="\033[0;31m"
DIM="\033[2m"

clear
echo -e "  ${BBLUE}╔══════════════════════════════════════════════════╗${RESET}"
echo -e "  ${BBLUE}║${RESET}  ${BCYAN}DevCulture VPS — Buat Akun SSH/OpenVPN${RESET}       ${BBLUE}║${RESET}"
echo -e "  ${BBLUE}║${RESET}  ${DIM}@devculturebot | v3.2.0${RESET}                       ${BBLUE}║${RESET}"
echo -e "  ${BBLUE}╚══════════════════════════════════════════════════╝${RESET}"
echo ""

MYIP=$(curl -fsSL --max-time 5 ipv4.icanhazip.com 2>/dev/null || hostname -I | awk '{print $1}')
DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo "$MYIP")
NS=$(cat /etc/xray/dns 2>/dev/null || echo "N/A")
PUB=$(cat /etc/slowdns/server.pub 2>/dev/null || echo "N/A")

echo -e "  ${DIM}Host: ${RESET}${BYELLOW}${DOMAIN}${RESET}  ${DIM}IP: ${RESET}${BYELLOW}${MYIP}${RESET}"
echo ""

# --- Input dengan validasi ---
while true; do
  read -rp "  👤 Username      : " Login
  [[ -n "$Login" && "$Login" =~ ^[a-z][a-z0-9_]{2,19}$ ]] && break
  echo -e "  ${RED}✘ Username tidak valid (3-20 karakter, huruf kecil/angka/_)${RESET}"
done

while true; do
  read -rp "  🔑 Password      : " Pass
  [[ -n "$Pass" && ${#Pass} -ge 6 ]] && break
  echo -e "  ${RED}✘ Password minimal 6 karakter${RESET}"
done

read -rp "  🖥  Limit IP (0=∞) : " iplimit
read -rp "  📦 Quota GB (0=∞) : " Quota
read -rp "  📅 Aktif (hari)   : " masaaktif

# --- Defaults ---
iplimit=${iplimit:-0}
Quota=${Quota:-0}
masaaktif=${masaaktif:-30}

echo ""
echo -e "  ${BYELLOW}⟳ Membuat akun...${RESET}"

# --- Dates ---
tgl=$(date -d "$masaaktif days" +"%d")
bln=$(date -d "$masaaktif days" +"%b")
thn=$(date -d "$masaaktif days" +"%Y")
expe="$tgl $bln, $thn"
tnggl=$(date +"%d %b, %Y")
hariini=$(date +"%Y-%m-%d")
expi=$(date -d "$masaaktif days" +"%Y-%m-%d")

# --- Create system user ---
useradd -e "$expi" -s /bin/false -M "$Login" 2>/dev/null || true
echo -e "${Pass}\n${Pass}" | passwd "$Login" &>/dev/null

# --- IP limit ---
if [[ "$iplimit" -gt 0 ]]; then
  mkdir -p /etc/devculture/limit/ssh/ip
  echo "$iplimit" > /etc/devculture/limit/ssh/ip/$Login
fi

# --- Quota ---
QUOTA_BYTES=0
if [[ "$Quota" -gt 0 ]]; then
  QUOTA_BYTES=$(( Quota * 1024 * 1024 * 1024 ))
  mkdir -p /etc/ssh
  echo "$QUOTA_BYTES" > /etc/ssh/$Login
fi

# --- Save DB ---
mkdir -p /etc/devculture
DB_FILE="/etc/devculture/users.json"
if [ ! -f "$DB_FILE" ]; then echo '{"users":[]}' > "$DB_FILE"; fi
node -e "
  const f='$DB_FILE';
  let db=JSON.parse(require('fs').readFileSync(f,'utf8'));
  db.users=db.users.filter(u=>u.user!=='$Login');
  db.users.push({user:'$Login',pass:'$Pass',exp:'$expi',quota:'$Quota',created:new Date().toISOString()});
  require('fs').writeFileSync(f,JSON.stringify(db,null,2));
" 2>/dev/null || {
  # Fallback: plain text DB
  mkdir -p /etc/ssh
  sed -i "/^#ssh# ${Login} /d" /etc/ssh/.ssh.db 2>/dev/null || true
  echo "#ssh# ${Login} ${Pass} ${Quota} ${iplimit} ${expe}" >> /etc/ssh/.ssh.db
}

# --- Save info file ---
mkdir -p /var/www/html
cat > /var/www/html/ssh-${Login}.txt << TXTEOF
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     DevCulture VPS — SSH Account
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Username     : $Login
Password     : $Pass
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
IP           : $MYIP
Host/Domain  : $DOMAIN
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Port OpenSSH : 22, 80, 443
Port Dropbear: 443, 109
Port SSH WS  : 80, 8080, 2082
Port SSH UDP : 1-65535
Port SSL/TLS : 400-900
Port OVPN SSL: 443
Port OVPN TCP: 1194, 443
Port OVPN UDP: 2200
BadVPN UDP   : 7100, 7300
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Payload WS   : GET / HTTP/1.1[crlf]Host: $DOMAIN[crlf]Upgrade: websocket[crlf][crlf]
Payload WSS  : GET wss://BUG.COM/ HTTP/1.1[crlf]Host: $DOMAIN[crlf]Upgrade: websocket[crlf][crlf]
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Limit IP     : $iplimit
Limit Quota  : $Quota GB
Dibuat       : $tnggl
Expired      : $expe
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
OVPN Download: https://$DOMAIN:81/
Info Lengkap : https://$DOMAIN:81/ssh-$Login.txt
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     @devculturebot | DevCulture VPS
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TXTEOF

# --- Telegram notification ---
CFG="/etc/devculture/config.json"
if [ -f "$CFG" ]; then
  BOT_TOKEN=$(grep -oP '"bot_token"\s*:\s*"\K[^"]+' "$CFG" 2>/dev/null || echo "")
  ADMIN_ID=$(grep -oP '"admin_id"\s*:\s*"\K[^"]+' "$CFG" 2>/dev/null || echo "")
  if [ -n "$BOT_TOKEN" ] && [ -n "$ADMIN_ID" ]; then
    TEXT="✅ <b>Akun SSH Baru Dibuat!</b>
━━━━━━━━━━━━━━━━━━━━
👤 Username  : <code>${Login}</code>
🔑 Password  : <code>${Pass}</code>
📅 Expired   : <code>${expe}</code>
📦 Quota     : <code>${Quota} GB</code>
🖥  Limit IP  : <code>${iplimit}</code>
━━━━━━━━━━━━━━━━━━━━
🌐 Host      : <code>${DOMAIN}</code>
🔌 Port SSH  : 22 | 80 | 443
🔌 Dropbear  : 443 | 109
🔌 WS        : 80 | 8080 | 2082
━━━━━━━━━━━━━━━━━━━━
📄 Detail    : https://${DOMAIN}:81/ssh-${Login}.txt
@devculturebot"
    curl -s --max-time 10 \
      -d "chat_id=${ADMIN_ID}&parse_mode=HTML&disable_web_page_preview=1&text=${TEXT}" \
      "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" > /dev/null 2>&1 || true
  fi
fi

# --- Log ---
mkdir -p /etc/user-create
LOG_FILE="/etc/user-create/user.log"
echo "$(date '+%Y-%m-%d %H:%M:%S') ADD_SSH user=${Login} exp=${expi} quota=${Quota}GB ip_limit=${iplimit}" >> "$LOG_FILE"

# --- Display result ---
clear
echo ""
echo -e "  ${BBLUE}╔══════════════════════════════════════════════════╗${RESET}"
echo -e "  ${BBLUE}║${RESET}  ${BGREEN}✔  Akun SSH Berhasil Dibuat!${RESET}                  ${BBLUE}║${RESET}"
echo -e "  ${BBLUE}╚══════════════════════════════════════════════════╝${RESET}"
echo ""
echo -e "  ${BYELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "  🌐 Host/Domain  : ${BCYAN}${DOMAIN}${RESET}"
echo -e "  👤 Username     : ${BCYAN}${Login}${RESET}"
echo -e "  🔑 Password     : ${BCYAN}${Pass}${RESET}"
echo -e "  📅 Expired      : ${BCYAN}${expe}${RESET}"
echo -e "  📦 Quota        : ${BCYAN}${Quota} GB${RESET}"
echo -e "  🖥  Limit IP     : ${BCYAN}${iplimit}${RESET}"
echo -e "  ${BYELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "  🔌 Port SSH     : 22, 80, 443"
echo -e "  🔌 Port Dropbear: 443, 109"
echo -e "  🔌 Port SSH WS  : 80, 8080, 2082"
echo -e "  🔌 Port UDP     : 1-65535"
echo -e "  🔌 Port OVPN    : TCP 1194 / UDP 2200"
echo -e "  ${BYELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "  📄 Detail       : ${DIM}https://${DOMAIN}:81/ssh-${Login}.txt${RESET}"
echo ""
read -rp "  Tekan ENTER untuk kembali ke menu... "
menu 2>/dev/null || true
